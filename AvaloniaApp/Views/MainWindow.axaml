<Window
    Height="600"
    Title="Piecewise Function Editor"
    Width="1000"
    x:Class="AvaloniaApp.Views.MainWindow"
    x:DataType="viewModels:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:avalonia="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
    xmlns:behaviours="clr-namespace:AvaloniaApp.Behaviours"
    xmlns:viewModels="clr-namespace:AvaloniaApp.ViewModels"
    xmlns:vm="using:AvaloniaApp.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Grid ColumnDefinitions="*, 300">
        <!--  Левая часть: график  -->
        <avalonia:CartesianChart
            DrawMarginFrame="{Binding DrawMarginFrame}"
            Grid.Column="0"
            Margin="10"
            Series="{Binding Series}"
            XAxes="{Binding XAxes}"
            YAxes="{Binding YAxes}"
            ZoomMode="None" />
        <!--  Правая часть: вкладки функций  -->
        <DockPanel
            Grid.Column="1"
            LastChildFill="True"
            Margin="5">
            <StackPanel
                DockPanel.Dock="Top"
                Orientation="Vertical"
                Spacing="6">
                <Button Command="{Binding Function.AddPointCommand}" Content="Добавить точку" />
                <Button Command="{Binding Function.RemovePointCommand}" Content="Удалить выбранную точку" />
                <ToggleButton
                    Content="Показать обратную функцию"
                    IsChecked="{Binding Function.IsInverseVisible, Mode=TwoWay}"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Width="200" />
            </StackPanel>
            <DataGrid
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="False"
                CanUserSortColumns="False"
                GridLinesVisibility="All"
                HeadersVisibility="Column"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding Function.Points}"
                Margin="5"
                SelectedItem="{Binding Function.SelectedPoint, Mode=TwoWay}"
                SelectionMode="Single"
                VerticalAlignment="Stretch"
                behaviours:DataGridEditOnClickBehavior.EnableEditOnClick="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="X" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Text="{Binding X}"
                                    VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <Border
                                    Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                    <TextBox
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        Padding="0"
                                        Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextAlignment="Center"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        behaviours:NumericInputBehavior.EnableNumericValidation="True" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Y" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Text="{Binding Y}"
                                    VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <Border
                                    Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                    <TextBox
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        Padding="0"
                                        Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextAlignment="Center"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        behaviours:NumericInputBehavior.EnableNumericValidation="True" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>
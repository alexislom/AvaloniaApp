<Window
    Height="600"
    Title="Piecewise Function Editor"
    Width="1000"
    x:Class="AvaloniaApp.Views.MainWindow"
    x:DataType="viewModels:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:avalonia="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
    xmlns:viewModels="clr-namespace:AvaloniaApp.ViewModels"
    xmlns:vm="using:AvaloniaApp.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Grid ColumnDefinitions="*, 320">
        <avalonia:CartesianChart
            Grid.Column="0"
            Margin="10"
            Series="{Binding Series}"
            XAxes="{Binding XAxes}"
            YAxes="{Binding YAxes}"
            ZoomMode="Both" />
        <DockPanel Background="DarkGreen" Grid.Column="1">
            <StackPanel
                DockPanel.Dock="Top"
                Orientation="Horizontal"
                Spacing="6">
                <Button Command="{Binding AddPointCommand}" Content="Добавить" />
                <Button Command="{Binding RemovePointCommand}" Content="Удалить выбранную" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <DataGrid
                    AutoGenerateColumns="False"
                    Background="BlueViolet"
                    Foreground="CornflowerBlue"
                    GridLinesVisibility="All"
                    HeadersVisibility="Column"
                    ItemsSource="{Binding Points}"
                    Margin="0,5,0,0"
                    SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Binding="{Binding X}"
                            Header="X"
                            Width="*" />
                        <DataGridTextColumn
                            Binding="{Binding Y}"
                            Header="Y"
                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>